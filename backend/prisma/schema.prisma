generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  KITCHEN_READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

// A role is data: its capabilities live here, so adding a role never means editing role-name checks in code.
model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  label        String
  capabilities String[]
  staff        Staff[]
}

model Staff {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String
  roleId          Int
  role            Role      @relation(fields: [roleId], references: [id])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  defaultDriverOf Company[] @relation("CompanyDefaultDriver")
}

// Never hard-deleted (orders reference it). Deactivating blocks new orders and cancels open ones.
model Company {
  id                     Int              @id @default(autoincrement())
  name                   String
  isActive               Boolean          @default(true)
  billingContactName     String
  billingContactEmail    String
  billingContactPhone    String?
  // Nullable only because the owner row is created in the same transaction as the company;
  // the API never leaves an active company without one.
  ownerId                Int?             @unique
  owner                  Employee?        @relation("CompanyOwner", fields: [ownerId], references: [id])
  workingDays            Int[]            @default([1, 2, 3, 4, 5]) // ISO weekday the company accepts deliveries
  defaultDeliveryTime    String           @default("12:30") // HH:mm, kitchen timezone
  deliveryWindowStart    String           @default("12:00") // employees allowed to change time pick inside this window
  deliveryWindowEnd      String           @default("14:00")
  dispatchLeadMinutes    Int              @default(60) // order must leave the kitchen this long before delivery
  defaultPackagingTypeId Int?
  defaultPackagingType   PackagingType?   @relation(fields: [defaultPackagingTypeId], references: [id])
  driverInstructions     String?
  defaultDriverId        Int?
  defaultDriver          Staff?           @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id])
  domains                CompanyDomain[]
  addresses              CompanyAddress[]
  holidays               CompanyHoliday[]
  employees              Employee[]       @relation("CompanyEmployees")
  orders                 Order[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  priceTier              PriceTier?       @relation(fields: [priceTierId], references: [id])
  priceTierId            Int?

  @@index([isActive, name])
}

// Globally unique: an email domain identifies exactly one company.
model CompanyDomain {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  domain    String  @unique

  @@index([companyId])
}

// Addresses are deactivated, not deleted, so past orders keep a valid delivery address.
// At most one default per company (partial unique index in the migration).
model CompanyAddress {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  label     String
  line1     String
  line2     String?
  area      String?
  city      String
  pincode   String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model CompanyHoliday {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  name      String

  @@unique([companyId, date])
}

model Employee {
  id                    Int          @id @default(autoincrement())
  name                  String
  email                 String       @unique // must match one of the company's domains (enforced by the API)
  phone                 String?
  companyId             Int
  company               Company      @relation("CompanyEmployees", fields: [companyId], references: [id])
  ownerOf               Company?     @relation("CompanyOwner")
  isActive              Boolean      @default(true)
  canChooseAddress      Boolean      @default(false) // may pick any of the company's active addresses
  canChangeDeliveryTime Boolean      @default(false) // may pick a time inside the company's delivery window
  canChangePackaging    Boolean      @default(false)
  allergens             Allergen[]
  dietaryTags           DietaryTag[] // dietary preferences
  orders                Order[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([companyId, isActive])
}

model Order {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  companyId    Int
  employee     Employee    @relation(fields: [employeeId], references: [id])
  company      Company     @relation(fields: [companyId], references: [id])
  status       OrderStatus @default(DRAFT)
  total        Decimal     @default(0) @db.Decimal(10, 2)
  deliveryDate DateTime
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId, deliveryDate])
  @@index([status, deliveryDate])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
}

// Singleton row (id = 1). Times are wall-clock in `timezone`, which is fixed at setup:
// changing it would silently reinterpret every stored cut-off and delivery time.
model KitchenSettings {
  id                         Int      @id @default(1)
  timezone                   String   @default("Asia/Kolkata")
  currency                   String   @default("USD")
  workingDays                Int[]    @default([1, 2, 3, 4, 5]) // ISO weekday: 1 = Monday ... 7 = Sunday
  cutoffTime                 String   @default("16:00") // HH:mm in kitchen timezone
  cutoffWorkingDays          Int      @default(1)
  kitchenReadyBufferMinutes  Int      @default(30) // kitchen-ready = dispatch-ready minus this
  defaultDispatchLeadMinutes Int      @default(60) // company default: minutes before delivery the order leaves
  updatedAt                  DateTime @updatedAt
}

model KitchenHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// Admin-managed reference lists. Rows are deactivated, never deleted, because catalogue items will reference them.
model Allergen {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  employees   Employee[]
  dishes      Dish[]
  options     Option[]
}

model DietaryTag {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  employees   Employee[]
  dishes      Dish[]
  options     Option[]
}

model KitchenStation {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  dishes      Dish[]
}

model PortionSize {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique
  description String?
  sortOrder   Int                      @default(0)
  isActive    Boolean                  @default(true)
  groups      OptionGroupPortion[]
  surcharges  OptionPortionSurcharge[]
}

model PackagingType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  companies   Company[]
}

// ---------- Catalogue (4.1). Money is integer cents everywhere. ----------

enum Temperature {
  HOT
  COLD
}

// Never hard-deleted: historical orders reference dishes.
model Dish {
  id           Int               @id @default(autoincrement())
  sku          String            @unique
  name         String
  description  String
  imageUrl     String?
  temperature  Temperature
  costCents    Int
  stationId    Int? // null = "Unassigned" on the kitchen board
  station      KitchenStation?   @relation(fields: [stationId], references: [id])
  minOrderQty  Int               @default(1) // minimum quantity of this dish on one order line
  isActive     Boolean           @default(true)
  allergens    Allergen[]
  dietaryTags  DietaryTag[]
  optionGroups DishOptionGroup[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  prices       DishPrice[]
}

// A reusable choice (paneer, jeera rice, raita) with its own cost, allergens and tags.
model Option {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique
  costCents   Int
  isActive    Boolean                  @default(true)
  allergens   Allergen[]
  dietaryTags DietaryTag[]
  groups      OptionGroupItem[]
  surcharges  OptionPortionSurcharge[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  prices      OptionPrice[]
}

// Reusable group ("Choose your roti") attached to many dishes. required = minSelect > 0.
model OptionGroup {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  minSelect    Int                  @default(1)
  maxSelect    Int                  @default(1)
  usesPortions Boolean              @default(false)
  isActive     Boolean              @default(true)
  items        OptionGroupItem[]
  portionSizes OptionGroupPortion[]
  dishes       DishOptionGroup[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model OptionGroupItem {
  groupId   Int
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  optionId  Int
  option    Option      @relation(fields: [optionId], references: [id])
  sortOrder Int

  @@id([groupId, optionId])
}

// Sizes a portioned group sells. Every option in the group must have a surcharge for each of these.
model OptionGroupPortion {
  groupId       Int
  group         OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  portionSizeId Int
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id])

  @@id([groupId, portionSizeId])
}

// Extra charge for an option in a size, on top of the option's tier price. Same on every tier.
model OptionPortionSurcharge {
  optionId       Int
  option         Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  portionSizeId  Int
  portionSize    PortionSize @relation(fields: [portionSizeId], references: [id])
  surchargeCents Int

  @@id([optionId, portionSizeId])
}

model DishOptionGroup {
  dishId    Int
  dish      Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  groupId   Int
  group     OptionGroup @relation(fields: [groupId], references: [id])
  sortOrder Int

  @@id([dishId, groupId])
}

// ---------- Pricing (4.3) ----------

enum PriceRule {
  MANUAL // every price typed in
  COST_MULTIPLIER // price = cost × ruleValueBps / 10000, rounded up to the next 5 cents
  TIER_PERCENT // price = base tier price × (10000 + ruleValueBps) / 10000, rounded up to the next 5 cents
}

// Exactly one tier is the default (partial unique index in the migration).
model PriceTier {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isDefault    Boolean       @default(false)
  rule         PriceRule     @default(MANUAL)
  ruleValueBps Int? // basis points: 24000 = × 2.4, 1500 = +15%, -800 = −8%
  baseTierId   Int?
  baseTier     PriceTier?    @relation("TierDerivation", fields: [baseTierId], references: [id])
  derivedTiers PriceTier[]   @relation("TierDerivation")
  companies    Company[]
  dishPrices   DishPrice[]
  optionPrices OptionPrice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// A typed price (MANUAL tier) or an override (derived tier); isUnavailable = deliberately not sold on this tier.
model DishPrice {
  tierId        Int
  tier          PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dishId        Int
  dish          Dish      @relation(fields: [dishId], references: [id])
  priceCents    Int?
  isUnavailable Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@id([tierId, dishId])
}

model OptionPrice {
  tierId        Int
  tier          PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  optionId      Int
  option        Option    @relation(fields: [optionId], references: [id])
  priceCents    Int?
  isUnavailable Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@id([tierId, optionId])
}
