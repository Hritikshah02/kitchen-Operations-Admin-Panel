generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 4.6. Kitchen and delivery progress are tracked separately (phases 7-8), not as order statuses.
enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED // withdrawn by staff, or a draft still open at cut-off
  REJECTED // the kitchen refused it (with a reason); never billable
}

enum OrderEventType {
  CREATED
  UPDATED
  PLACED
  CONFIRMED
  CANCELLED
  REJECTED
  DELIVERY_CHANGED
  ALLERGY_ACKNOWLEDGED
  DELIVERED
  KITCHEN_STARTED
  KITCHEN_READY
  FORCE_COMPLETED
  DRIVER_ASSIGNED
  DISPATCH_READY
  OUT_FOR_DELIVERY
  INVOICED
  CREDITED
}

// A role is data: its capabilities live here, so adding a role never means editing role-name checks in code.
model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  label        String
  capabilities String[]
  staff        Staff[]
}

model Staff {
  id              Int                @id @default(autoincrement())
  name            String
  email           String             @unique
  passwordHash    String
  roleId          Int
  role            Role               @relation(fields: [roleId], references: [id])
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  defaultDriverOf Company[]          @relation("CompanyDefaultDriver")
  ordersCreated   Order[]            @relation("OrderCreatedBy")
  orderEvents     OrderEvent[]       @relation("OrderEventActor")
  unitsStarted    OrderCombination[] @relation("UnitStartedBy")
  unitsDone       OrderCombination[] @relation("UnitDoneBy")
  ordersDriving   Order[]            @relation("OrderDriver")
  invoicesCreated Invoice[]          @relation("InvoiceCreatedBy")
  invoicesPaid    Invoice[]          @relation("InvoicePaidBy")
  invoicesVoided  Invoice[]          @relation("InvoiceVoidedBy")
  creditsCreated  OrderCredit[]      @relation("CreditCreatedBy")
  ordersDelivered Order[]            @relation("OrderDeliveredBy")
}

// Never hard-deleted (orders reference it). Deactivating blocks new orders and cancels open ones.
model Company {
  id                     Int                     @id @default(autoincrement())
  name                   String
  isActive               Boolean                 @default(true)
  billingContactName     String
  billingContactEmail    String
  billingContactPhone    String?
  // Nullable only because the owner row is created in the same transaction as the company;
  // the API never leaves an active company without one.
  ownerId                Int?                    @unique
  owner                  Employee?               @relation("CompanyOwner", fields: [ownerId], references: [id])
  workingDays            Int[]                   @default([1, 2, 3, 4, 5]) // ISO weekday the company accepts deliveries
  defaultDeliveryTime    String                  @default("12:30") // HH:mm, kitchen timezone
  deliveryWindowStart    String                  @default("12:00") // employees allowed to change time pick inside this window
  deliveryWindowEnd      String                  @default("14:00")
  dispatchLeadMinutes    Int                     @default(60) // order must leave the kitchen this long before delivery
  defaultPackagingTypeId Int?
  defaultPackagingType   PackagingType?          @relation(fields: [defaultPackagingTypeId], references: [id])
  driverInstructions     String?
  defaultDriverId        Int?
  defaultDriver          Staff?                  @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id])
  domains                CompanyDomain[]
  addresses              CompanyAddress[]
  holidays               CompanyHoliday[]
  employees              Employee[]              @relation("CompanyEmployees")
  orders                 Order[]
  invoices               Invoice[]
  credits                OrderCredit[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  priceTier              PriceTier?              @relation(fields: [priceTierId], references: [id])
  priceTierId            Int?
  hiddenCategories       CompanyHiddenCategory[]
  hiddenDishes           CompanyHiddenDish[]

  @@index([isActive, name])
}

// Globally unique: an email domain identifies exactly one company.
model CompanyDomain {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  domain    String  @unique

  @@index([companyId])
}

// Addresses are deactivated, not deleted, so past orders keep a valid delivery address.
// At most one default per company (partial unique index in the migration).
model CompanyAddress {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  label     String
  line1     String
  line2     String?
  area      String?
  city      String
  pincode   String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([companyId])
}

model CompanyHoliday {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  name      String

  @@unique([companyId, date])
}

model Employee {
  id                    Int          @id @default(autoincrement())
  name                  String
  email                 String       @unique // must match one of the company's domains (enforced by the API)
  phone                 String?
  companyId             Int
  company               Company      @relation("CompanyEmployees", fields: [companyId], references: [id])
  ownerOf               Company?     @relation("CompanyOwner")
  isActive              Boolean      @default(true)
  canChooseAddress      Boolean      @default(false) // may pick any of the company's active addresses
  canChangeDeliveryTime Boolean      @default(false) // may pick a time inside the company's delivery window
  canChangePackaging    Boolean      @default(false)
  allergens             Allergen[]
  dietaryTags           DietaryTag[] // dietary preferences
  orders                Order[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([companyId, isActive])
}

model Order {
  id                  Int            @id @default(autoincrement())
  employeeId          Int
  employee            Employee       @relation(fields: [employeeId], references: [id])
  companyId           Int // snapshot: the company billed, even if the employee moves later
  company             Company        @relation(fields: [companyId], references: [id])
  status              OrderStatus    @default(DRAFT)
  deliveryDate        DateTime       @db.Date // a day in the kitchen timezone
  deliveryTime        String // HH:mm, kitchen timezone
  addressId           Int
  address             CompanyAddress @relation(fields: [addressId], references: [id])
  packagingTypeId     Int?
  packagingType       PackagingType? @relation(fields: [packagingTypeId], references: [id])
  priceTierId         Int // the tier that priced it
  priceTier           PriceTier      @relation(fields: [priceTierId], references: [id])
  totalCents          Int            @default(0)
  allergyAcknowledged Boolean        @default(false)
  notes               String?
  version             Int            @default(1) // optimistic concurrency: every write must send the version it read
  placedAt            DateTime?
  confirmedAt         DateTime?
  kitchenStartedAt    DateTime? // first unit's start
  kitchenReadyAt      DateTime? // set only when every unit is done
  driverId            Int? // set when dispatch assigns a driver; until then the company's default driver applies
  driver              Staff?         @relation("OrderDriver", fields: [driverId], references: [id])
  dispatchReadyAt     DateTime?
  outForDeliveryAt    DateTime?
  deliveredById       Int?
  deliveredBy         Staff?         @relation("OrderDeliveredBy", fields: [deliveredById], references: [id])
  deliveryNote        String?
  deliveryPhotoUrl    String?
  deliveryLateMinutes Int? // minutes after the delivery time (0 when early); stored even within the grace
  deliveredOnTime     Boolean? // late minutes within the grace setting
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdById         Int
  createdBy           Staff          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  lines               OrderLine[]
  events              OrderEvent[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  invoiceId           Int? // an order is on at most one invoice (voiding an invoice releases its orders)
  invoice             Invoice?       @relation(fields: [invoiceId], references: [id])
  credits             OrderCredit[]

  @@index([deliveryDate, status])
  @@index([companyId, deliveryDate])
  @@index([employeeId, deliveryDate])
  @@index([driverId, deliveryDate])
  @@index([invoiceId])
}

// What was ordered and at what price; names are snapshotted so catalogue edits never change a past order.
model OrderLine {
  id             Int                @id @default(autoincrement())
  orderId        Int
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId         Int
  dish           Dish               @relation(fields: [dishId], references: [id])
  dishName       String
  dishSku        String
  quantity       Int
  unitPriceCents Int // the dish's own price
  totalCents     Int // sum of its combinations
  sortOrder      Int
  combinations   OrderCombination[]
}

// One distinct set of choices for part of a line's quantity. The kitchen cooks each as one prep unit (4.7).
model OrderCombination {
  id             Int           @id @default(autoincrement())
  lineId         Int
  line           OrderLine     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  signature      String // normalised choice key; identical combinations are merged
  quantity       Int
  unitPriceCents Int // dish price + chosen option prices (+ size surcharges)
  totalCents     Int // unitPriceCents × quantity
  choices        OrderChoice[]
  startedAt      DateTime?
  startedById    Int?
  startedBy      Staff?        @relation("UnitStartedBy", fields: [startedById], references: [id])
  doneAt         DateTime?
  doneById       Int?
  doneBy         Staff?        @relation("UnitDoneBy", fields: [doneById], references: [id])

  @@unique([lineId, signature])
}

model OrderChoice {
  id             Int              @id @default(autoincrement())
  combinationId  Int
  combination    OrderCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  groupId        Int
  groupName      String
  optionId       Int
  optionName     String
  portionSizeId  Int?
  portionName    String?
  unitPriceCents Int // option price + size surcharge
}

model OrderEvent {
  id        Int            @id @default(autoincrement())
  orderId   Int
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  message   String
  actorId   Int? // null = the system (cut-off processing)
  actor     Staff?         @relation("OrderEventActor", fields: [actorId], references: [id])
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}

// Log of cut-off processing runs (automatic or manual); processing itself is idempotent.
model CutoffRun {
  id             Int      @id @default(autoincrement())
  deliveryDate   DateTime @db.Date
  trigger        String // "scheduler" | "manual"
  actorId        Int?
  confirmedCount Int
  cancelledCount Int
  ranAt          DateTime @default(now())

  @@index([deliveryDate])
}

// Singleton row (id = 1). Times are wall-clock in `timezone`, which is fixed at setup:
// changing it would silently reinterpret every stored cut-off and delivery time.
model KitchenSettings {
  id                         Int      @id @default(1)
  timezone                   String   @default("Asia/Kolkata")
  currency                   String   @default("USD")
  workingDays                Int[]    @default([1, 2, 3, 4, 5, 6]) // ISO weekday: 1 = Monday ... 7 = Sunday
  cutoffTime                 String   @default("16:00") // HH:mm in kitchen timezone
  cutoffWorkingDays          Int      @default(1)
  kitchenReadyBufferMinutes  Int      @default(30) // kitchen-ready = dispatch-ready minus this
  onTimeGraceMinutes         Int      @default(5) // a delivery this many minutes late still counts as on time
  defaultDispatchLeadMinutes Int      @default(60) // company default: minutes before delivery the order leaves
  updatedAt                  DateTime @updatedAt
}

model KitchenHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// Admin-managed reference lists. Rows are deactivated, never deleted, because catalogue items will reference them.
model Allergen {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  employees   Employee[]
  dishes      Dish[]
  options     Option[]
}

model DietaryTag {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  employees   Employee[]
  dishes      Dish[]
  options     Option[]
}

model KitchenStation {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  dishes      Dish[]
}

model PortionSize {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique
  description String?
  sortOrder   Int                      @default(0)
  isActive    Boolean                  @default(true)
  groups      OptionGroupPortion[]
  surcharges  OptionPortionSurcharge[]
}

model PackagingType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  companies   Company[]
  orders      Order[]
}

// ---------- Catalogue (4.1). Money is integer cents everywhere. ----------

enum Temperature {
  HOT
  COLD
}

// Never hard-deleted: historical orders reference dishes.
model Dish {
  id           Int                 @id @default(autoincrement())
  sku          String              @unique
  name         String
  description  String
  imageUrl     String?
  temperature  Temperature
  costCents    Int
  stationId    Int? // null = "Unassigned" on the kitchen board
  station      KitchenStation?     @relation(fields: [stationId], references: [id])
  minOrderQty  Int                 @default(1) // minimum quantity of this dish on one order line
  isActive     Boolean             @default(true)
  allergens    Allergen[]
  dietaryTags  DietaryTag[]
  optionGroups DishOptionGroup[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  prices       DishPrice[]
  menuItems    MenuItem[]
  hiddenFor    CompanyHiddenDish[]
  orderLines   OrderLine[]
}

// A reusable choice (paneer, jeera rice, raita) with its own cost, allergens and tags.
model Option {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique
  costCents   Int
  isActive    Boolean                  @default(true)
  allergens   Allergen[]
  dietaryTags DietaryTag[]
  groups      OptionGroupItem[]
  surcharges  OptionPortionSurcharge[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  prices      OptionPrice[]
}

// Reusable group ("Choose your roti") attached to many dishes. required = minSelect > 0.
model OptionGroup {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  minSelect    Int                  @default(1)
  maxSelect    Int                  @default(1)
  usesPortions Boolean              @default(false)
  isActive     Boolean              @default(true)
  items        OptionGroupItem[]
  portionSizes OptionGroupPortion[]
  dishes       DishOptionGroup[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model OptionGroupItem {
  groupId   Int
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  optionId  Int
  option    Option      @relation(fields: [optionId], references: [id])
  sortOrder Int

  @@id([groupId, optionId])
}

// Sizes a portioned group sells. Every option in the group must have a surcharge for each of these.
model OptionGroupPortion {
  groupId       Int
  group         OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  portionSizeId Int
  portionSize   PortionSize @relation(fields: [portionSizeId], references: [id])

  @@id([groupId, portionSizeId])
}

// Extra charge for an option in a size, on top of the option's tier price. Same on every tier.
model OptionPortionSurcharge {
  optionId       Int
  option         Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  portionSizeId  Int
  portionSize    PortionSize @relation(fields: [portionSizeId], references: [id])
  surchargeCents Int

  @@id([optionId, portionSizeId])
}

model DishOptionGroup {
  dishId    Int
  dish      Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  groupId   Int
  group     OptionGroup @relation(fields: [groupId], references: [id])
  sortOrder Int

  @@id([dishId, groupId])
}

// ---------- Pricing (4.3) ----------

enum PriceRule {
  MANUAL // every price typed in
  COST_MULTIPLIER // price = cost × ruleValueBps / 10000, rounded up to the next 5 cents
  TIER_PERCENT // price = base tier price × (10000 + ruleValueBps) / 10000, rounded up to the next 5 cents
}

// Exactly one tier is the default (partial unique index in the migration).
model PriceTier {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isDefault    Boolean       @default(false)
  rule         PriceRule     @default(MANUAL)
  ruleValueBps Int? // basis points: 24000 = × 2.4, 1500 = +15%, -800 = −8%
  baseTierId   Int?
  baseTier     PriceTier?    @relation("TierDerivation", fields: [baseTierId], references: [id])
  derivedTiers PriceTier[]   @relation("TierDerivation")
  companies    Company[]
  dishPrices   DishPrice[]
  optionPrices OptionPrice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
}

// A typed price (MANUAL tier) or an override (derived tier); isUnavailable = deliberately not sold on this tier.
model DishPrice {
  tierId        Int
  tier          PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dishId        Int
  dish          Dish      @relation(fields: [dishId], references: [id])
  priceCents    Int?
  isUnavailable Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@id([tierId, dishId])
}

model OptionPrice {
  tierId        Int
  tier          PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  optionId      Int
  option        Option    @relation(fields: [optionId], references: [id])
  priceCents    Int?
  isUnavailable Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@id([tierId, optionId])
}

// ---------- Menu (4.2) ----------

// Secret = left out of the browsable menu but still reachable by searching when building an order.
model MenuCategory {
  id          Int                     @id @default(autoincrement())
  name        String                  @unique
  description String?
  sortOrder   Int
  isActive    Boolean                 @default(true)
  isSecret    Boolean                 @default(false)
  items       MenuItem[]
  hiddenFor   CompanyHiddenCategory[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

// A dish placed in a category. A dish may appear in several categories.
model MenuItem {
  id         Int          @id @default(autoincrement())
  categoryId Int
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dishId     Int
  dish       Dish         @relation(fields: [dishId], references: [id])
  sortOrder  Int
  isActive   Boolean      @default(true)

  @@unique([categoryId, dishId])
}

model CompanyHiddenCategory {
  companyId  Int
  company    Company      @relation(fields: [companyId], references: [id])
  categoryId Int
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([companyId, categoryId])
}

// Hiding is per dish, so a dish hidden from a company is hidden in every category it appears in.
model CompanyHiddenDish {
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  dishId    Int
  dish      Dish    @relation(fields: [dishId], references: [id])

  @@id([companyId, dishId])
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

enum InvoiceLineType {
  ORDER
  CREDIT
}

enum CreditKind {
  CANCELLED
  REJECTED
  SHORT_DELIVERY
}

enum CreditStatus {
  OPEN // owed to the company; applied to its next invoice
  APPLIED // taken off an invoice (appliedInvoiceId), or netted off an order not yet invoiced
  DISCARDED // the invoice was voided and the order is no longer billable
}

// An internal record, no accounting integration. Total = sum of its lines (order lines plus credit lines).
model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique // INV-00001
  companyId      Int
  company        Company       @relation(fields: [companyId], references: [id])
  status         InvoiceStatus @default(UNPAID)
  totalCents     Int
  notes          String?
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  paidById       Int?
  paidBy         Staff?        @relation("InvoicePaidBy", fields: [paidById], references: [id])
  voidedAt       DateTime?
  voidReason     String?
  voidedById     Int?
  voidedBy       Staff?        @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  createdById    Int
  createdBy      Staff         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines          InvoiceLine[]
  orders         Order[] // orders currently on it (empty once voided)
  creditsApplied OrderCredit[] @relation("CreditAppliedTo")
  creditsSourced OrderCredit[] @relation("CreditSource")

  @@index([companyId, status])
}

model InvoiceLine {
  id          Int             @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        InvoiceLineType
  orderId     Int?
  creditId    Int?
  credit      OrderCredit?    @relation(fields: [creditId], references: [id])
  description String
  amountCents Int // negative for credits
  sortOrder   Int

  @@index([invoiceId])
  @@index([orderId])
}

// Money owed back to a company because an invoiced order was cancelled, rejected or came up short.
model OrderCredit {
  id               Int           @id @default(autoincrement())
  companyId        Int
  company          Company       @relation(fields: [companyId], references: [id])
  orderId          Int
  order            Order         @relation(fields: [orderId], references: [id])
  kind             CreditKind
  amountCents      Int // positive
  reason           String
  items            Json? // short deliveries: [{ combinationId, quantity }] so the same missing item cannot be credited twice
  status           CreditStatus  @default(OPEN)
  sourceInvoiceId  Int? // the invoice the order was on when the credit arose
  sourceInvoice    Invoice?      @relation("CreditSource", fields: [sourceInvoiceId], references: [id])
  appliedInvoiceId Int?
  appliedInvoice   Invoice?      @relation("CreditAppliedTo", fields: [appliedInvoiceId], references: [id])
  lines            InvoiceLine[]
  createdById      Int
  createdBy        Staff         @relation("CreditCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())

  @@index([companyId, status])
  @@index([orderId])
}
