DATABASE_URL="postgresql://kitchen_user:kitchen_password@localhost:5433/kitchen_db?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# "local" | "dev" | "prod" - only used for logs/health output; NODE_ENV stays "production" on every deployed service
APP_ENV="local"
# Optional: signed image uploads (dish photos, delivery photos). cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
# Optional: enables POST /api/demo/refresh (x-demo-token header), used by the daily GitHub Action
DEMO_REFRESH_TOKEN=""
